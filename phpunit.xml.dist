<?xml version="1.0" encoding="UTF-8"?>
<phpunit
	bootstrap="tests/bootstrap.php"
	backupGlobals="false"
	colors="true"
	convertErrorsToExceptions="true"
	convertNoticesToExceptions="true"
	convertWarningsToExceptions="true"
	>
	<testsuites>
		<testsuite name="domain-mapping-system">
			<directory suffix=".php">./tests</directory>
		</testsuite>
	</testsuites>
	<php>
		<!-- Default to multisite, but do not override an explicit WP_MULTISITE
		     from the environment: CI runs this suite in both modes via a matrix. -->
		<env name="WP_MULTISITE" value="1" force="false"/>
	</php>
</phpunit>
